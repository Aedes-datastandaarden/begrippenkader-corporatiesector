---
import versions from '../../../public/build/versions.json';
import allConcepts from '../../../public/build/latest/concepts.json';
import type { Concept } from '../../lib/types';
import { conceptUrl } from '../../lib/version';

export function getStaticPaths() {
  return (allConcepts as Concept[]).map((concept) => ({
    params: { id: concept.slug },
    props: { slug: concept.slug },
  }));
}

const { slug } = Astro.props;
return Astro.redirect(conceptUrl(slug));
---
