---
import Layout from '../../../layouts/Layout.astro';
import ConceptDetail from '../../../components/ConceptDetail';
import RelationGraph from '../../../components/RelationGraph';
import versions from '../../../../public/build/versions.json';
import allConcepts from '../../../../public/build/latest/concepts.json';
import allCollections from '../../../../public/build/latest/collections.json';
import type { Concept, Collection } from '../../../lib/types';

export function getStaticPaths() {
  return (allConcepts as Concept[]).map((concept) => ({
    params: { slug: concept.slug },
  }));
}

const { slug } = Astro.params;
const concept = (allConcepts as Concept[]).find((c) => c.slug === slug)!;
const owningCollection = (allCollections as Collection[]).find((c) =>
  c.members.some((m) => m.slug === slug),
);
const defaultCollection = owningCollection
  ? { slug: owningCollection.slug, prefLabel: owningCollection.prefLabel }
  : null;
---

<Layout title={concept.prefLabel} description={concept.definition}>
  <ConceptDetail client:load slug={slug!} defaultConcept={concept} defaultCollection={defaultCollection} versionsManifest={versions} />
  <RelationGraph client:load slug={slug!} defaultConcept={concept} versionsManifest={versions} />
</Layout>
